# Copy to .env (never committed) and fill in the empty values.
# No password or key is written here: generate your own, for example with
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=
DEBUG=True
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5435/<POSTGRES_DB>
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker-compose.yml). Use URL-safe characters in the password,
# because it also goes inside DATABASE_URL. An existing volume keeps the
# password it was created with.
POSTGRES_DB=medbook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Test PostgreSQL (docker-compose.test.yml, port 5436)
POSTGRES_TEST_PASSWORD=

# Email: 'console' localmente, 'anymail.backends.resend.EmailBackend' en prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=

DEFAULT_FROM_EMAIL=MedBook <noreply@yourdomain.com>
